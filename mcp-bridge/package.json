    "index.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/youyouhe/webmcp-retrofit.git"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "cdp",
    "puppeteer",
    "bridge"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "puppeteer-core": "^24.0.0"
  }
}